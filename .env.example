# PS10 Autonomous Cloud IAM Least-Privilege Mitigator Configuration

# LLM Provider: openai, gemini, anthropic, or custom (compatible with OpenAI format)
LLM_PROVIDER=openai

# Model identifier
LLM_MODEL=gpt-4o

# API Key (leave empty or set MOCK_LLM=true to run in deterministic offline mode)
LLM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Custom Base URL (optional, e.g. https://api.openai.com/v1 or local vLLM/Ollama/OpenRouter)
LLM_BASE_URL=https://api.openai.com/v1

# Run in deterministic mock mode without network calls or LLM keys
MOCK_LLM=false

# Bounded Execution Limits
MAX_ITERATIONS=20
MAX_TOOL_CALLS=30
MAX_REPLANS=5
MAX_RUNTIME_SECONDS=120
MAX_CONTEXT_EVENTS=100

# API Server (Fix #2/#3/#8)
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
STATE_STORE=sqlite
RUNS_DB=data/iam_runs.db
RUNS_DIR=data/runs
RATE_LIMIT_PER_MIN=30
