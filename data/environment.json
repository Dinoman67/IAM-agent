  "services": [
    {
      "id": "PaymentService",
      "name": "Payment Processing Service",
      "owner": "Payment Engineering Team"
    },
    {
      "id": "S3",
      "name": "Amazon Simple Storage Service",
      "owner": "Cloud Infrastructure Team"
    },
    {
      "id": "KMS",
      "name": "AWS Key Management Service",
      "owner": "Security Engineering Team"
    }
  ],
  "dependencies": [
    {
      "service": "PaymentService",
      "calls_service": "S3",
      "downstream_dependency": "KMS",
      "required_permission": "kms:Decrypt",
      "reason": "PaymentService reads customer checkout records from encrypted S3 bucket 'payment-transactions', which uses KMS key 'arn:aws:kms:::key/payment-key' (SSE-KMS). Reading objects requires kms:Decrypt."
    }
  ],
  "resources": [
    {
      "id": "res-s3-payments",
      "arn": "arn:aws:s3:::payment-transactions/*",
      "type": "s3",
      "is_protected": false,
      "required_permissions": ["s3:GetObject", "s3:PutObject"]
    },
    {
      "id": "res-kms-payment-key",
      "arn": "arn:aws:kms:::key/payment-key",
      "type": "kms",
      "is_protected": false,
      "required_permissions": ["kms:Decrypt"]
    },
    {
      "id": "res-iam-admin",
      "arn": "arn:aws:iam:::user/admin",
      "type": "iam",
      "is_protected": true,
      "required_permissions": ["iam:*"]
    },
    {
      "id": "res-ec2-prod",
      "arn": "arn:aws:ec2:::instance/*",
      "type": "ec2",
      "is_protected": true,
      "required_permissions": ["ec2:*"]
    },
    {
      "id": "res-dynamodb-pii",
      "arn": "arn:aws:dynamodb:::table/customer-pii",
      "type": "dynamodb",
      "is_protected": true,
      "required_permissions": ["dynamodb:*"]
    }
  ],
  "workflows": [
    {
      "id": "payment_checkout",
      "name": "Payment Checkout Workflow",
      "description": "Reads encrypted checkout transaction from S3, writes completed receipt to S3, and emits metric",
      "role_id": "PaymentServiceRole",
      "required_permissions": [
        "s3:GetObject",
        "s3:PutObject",
        "kms:Decrypt",
        "cloudwatch:PutMetricData"
      ],
      "hidden_dependency_notes": "S3 object retrieval requires kms:Decrypt for SSE-KMS customer key decryption"
    }
  ],
  "simulation_runs": []
}
