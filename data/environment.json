{
  "principals": [
    {
      "id": "principal-payment-svc",
      "name": "PaymentServicePrincipal",
      "type": "Service",
      "roles": ["PaymentServiceRole"]
    }
  ],
  "roles": [
    {
      "id": "PaymentServiceRole",
      "name": "PaymentServiceRole",
      "description": "IAM execution role for customer payment transactions and checkout processing",
      "current_version": "v1",
      "policy_versions": [
        {
          "version_id": "v1",
          "permissions": [
            "s3:GetObject",
            "s3:PutObject",
            "kms:Decrypt",
            "ec2:*",
            "iam:*",
            "dynamodb:*",
            "cloudwatch:PutMetricData"
          ],
          "created_at": "2026-09-01T00:00:00Z",
          "is_active": true,
          "reason": "Initial deployment configuration with broad permissions"
        }
      ]
    }
  ],
  "permissions": [
    {
      "id": "s3:GetObject",
      "service": "s3",
      "description": "Read objects from S3 buckets",
      "risk_level": "low"
    },
    {
      "id": "s3:PutObject",
      "service": "s3",
      "description": "Write objects to S3 buckets",
      "risk_level": "medium"
    },
    {
      "id": "kms:Decrypt",
      "service": "kms",
      "description": "Decrypt ciphertext with KMS customer managed keys",
      "risk_level": "medium"
    },
    {
      "id": "cloudwatch:PutMetricData",
      "service": "cloudwatch",
      "description": "Publish custom metric data points",
      "risk_level": "low"
    },
    {
      "id": "ec2:*",
      "service": "ec2",
      "description": "Full administrative control over EC2 compute instances",
      "risk_level": "critical"
    },
    {
      "id": "iam:*",
      "service": "iam",
      "description": "Full administrative control over IAM identities and policies",
      "risk_level": "critical"
    },
    {
      "id": "dynamodb:*",
      "service": "dynamodb",
      "description": "Full administrative control over DynamoDB tables and data",
      "risk_level": "critical"
    }
  ],
  "bindings": [
    {
      "principal_id": "principal-payment-svc",
      "role_id": "PaymentServiceRole",
      "attached_at": "2026-09-01T00:00:00Z"
    }
  ],
