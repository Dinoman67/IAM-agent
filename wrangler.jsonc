{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iam-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "containers": [
    {
      "class_name": "IAMAgentContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IAM_AGENT",
        "class_name": "IAMAgentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IAMAgentContainer"]
    }
  ],
  "upload_source_maps": true
}
